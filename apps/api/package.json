{
  "name": "@leadnet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@leadnet/shared": "*",
    "@google/genai": "^1.20.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "firebase-admin": "^13.5.0",
    "geofire-common": "^6.0.0",
    "hono": "^4.9.0",
    "nanoid": "^5.1.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
