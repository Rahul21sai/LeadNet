GOOGLE_CLOUD_PROJECT=leadnet-blr
STORAGE_BUCKET=leadnet-blr.firebasestorage.app
VERTEX_LOCATION=global
PORT=8080
# Explicitly opt into deterministic AI fallbacks for local development.
AI_MOCK=1
DEMO_MODE=1
# MODEL_TRIAGE, MODEL_DEDUPE, MODEL_EVIDENCE, MODEL_BRIEF, MODEL_COMPOSE override env.ts defaults.
# Do not place service-account JSON or tokens in this repository.
# Optional direct email. Use a Resend key with a verified sending domain.
# Without these values, the app offers reviewed drafts and keeps direct sending disabled.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_APP_URL=
# Video remains unavailable unless a trusted local/server FFmpeg binary is installed.
FFMPEG_PATH=ffmpeg
